{
  "name": "davis-higgins-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "media": "node scripts/build-media.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "npm run content && tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run content && vitest run",
    "test:e2e": "playwright test",
    "verify:notes": "node scripts/export-note-bodies.mjs && python scripts/verify_notes.py --rendered-dir .verify/note-bodies",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "framer-motion": "^11.0.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
